<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="PrimaryColor">#FFFFFF</Color>
    <Color x:Key="PrimaryBackgroundColor">#F3F4F6</Color>
    <Color x:Key="PrimaryTextColor">#1F2937</Color>
    <Color x:Key="SuccessColor">#008C4A</Color>
    <Color x:Key="ErrorColor">#DC2626</Color>
    <Color x:Key="CopperColor">#E2C457</Color>

    <Color x:Key="BlueColor">#2563EB</Color>
    <Color x:Key="BlueHoverColor">#1D4ED8</Color>
    <Color x:Key="HoverColor">#C7E7F1</Color>

    <Color x:Key="BorderColor">#D1D5DB</Color>
    <Color x:Key="TitleBarColor">#263545</Color>
    <Color x:Key="TitleTextColor">#F4F7FA</Color>
    <Color x:Key="TextSecondaryColor">#6B7280</Color>

    <Color x:Key="AccentSurfaceColor">#EAF2FF</Color>
    <Color x:Key="AccentSurfaceHoverColor">#DCEAFF</Color>

    <Color x:Key="InputTextColor">#20252B</Color>
    <Color x:Key="SurfaceAltColor">#ECEFF2</Color>


    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource PrimaryBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource BlueColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource BlueHoverColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />

    <SolidColorBrush x:Key="TitleBarBrush" Color="{StaticResource TitleBarColor}" />
    <SolidColorBrush x:Key="TitleTextBrush" Color="{StaticResource TitleTextColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="CopperBrush" Color="{StaticResource CopperColor}" />
    <SolidColorBrush x:Key="InputBrush" Color="{StaticResource PrimaryColor}" />

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="InputTextBrush" Color="{StaticResource InputTextColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />

    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="AccentSurfaceBrush" Color="{StaticResource AccentSurfaceColor}" />
    <SolidColorBrush x:Key="AccentSurfaceHoverBrush" Color="{StaticResource AccentSurfaceHoverColor}" />

</ResourceDictionary>
