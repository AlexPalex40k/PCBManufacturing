<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="PrimaryColor">#1E1F22</Color>
    <Color x:Key="PrimaryBackgroundColor">#2B2D30</Color>
    <Color x:Key="PrimaryTextColor">#E5E7EB</Color>
    <Color x:Key="SuccessColor">#008C4A</Color>
    <Color x:Key="ErrorColor">#F87171</Color>
    <Color x:Key="CopperColor">#E2C457</Color>

    <Color x:Key="BlueColor">#3B82F6</Color>
    <Color x:Key="HoverColor">#244D5B</Color>

    <Color x:Key="BorderColor">#43454A</Color>
    <Color x:Key="TitleTextColor">#F4F7FA</Color>
    <Color x:Key="TitleBarColor">#263545</Color>
    <Color x:Key="TextSecondaryColor">#9CA3AF</Color>

    <Color x:Key="AccentSurfaceColor">#1E3554</Color>
    <Color x:Key="AccentSurfaceHoverColor">#29466C</Color>

    <Color x:Key="InputTextColor">#E4E8EC</Color>
    <Color x:Key="SurfaceAltColor">#1E242B</Color>


    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource PrimaryBackgroundColor}" />
	<SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource BlueColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />

    <SolidColorBrush x:Key="TitleBarBrush" Color="{StaticResource TitleBarColor}" />
    <SolidColorBrush x:Key="TitleTextBrush" Color="{StaticResource TitleTextColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="CopperBrush" Color="{StaticResource CopperColor}" />

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="InputTextBrush" Color="{StaticResource InputTextColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="AccentSurfaceBrush" Color="{StaticResource AccentSurfaceColor}" />
    <SolidColorBrush x:Key="AccentSurfaceHoverBrush" Color="{StaticResource AccentSurfaceHoverColor}" />

    <SolidColorBrush x:Key="DataGridBackgroundBrush" Color="{StaticResource BorderColor}" />

</ResourceDictionary>
