<Window
    x:Class="PCBManufacturing.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:order="clr-namespace:PCBManufacturing.Features.Order"
    xmlns:preferences="clr-namespace:PCBManufacturing.Features.Preferences"
    xmlns:quote="clr-namespace:PCBManufacturing.Features.Quote"
    Title="PCB Manufacturing"
    MinWidth="500"
    MinHeight="300"
    Background="{DynamicResource WindowBackgroundBrush}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <DataTemplate DataType="{x:Type preferences:PreferencesViewModel}">
            <preferences:PreferencesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type quote:QuoteViewModel}">
            <quote:QuoteView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type order:OrderViewModel}">
            <order:OrderView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="10,2"
            Background="{DynamicResource TitleBarBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">

                    <Viewbox
                        Width="24"
                        Height="24"
                        Margin="0,0,9,0"
                        VerticalAlignment="Center"
                        SnapsToDevicePixels="True"
                        Stretch="Uniform">

                        <Canvas
                            Width="64"
                            Height="64">

                            <Path
                                Data=" M 5,13 Q 5,8 10,8 L 34,8  L 34,5 Q 34,2 38,2 L 58,2 Q 62,2 62,6 L 62,58 Q 62,62 58,62 L 9,62  Q 5,62 5,58 Z"
                                Fill="{StaticResource SuccessBrush}" />

                            <Line
                                Stroke="{StaticResource CopperBrush}"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="2.7"
                                X1="20"
                                X2="20"
                                Y1="18"
                                Y2="50" />

                            <Line
                                Stroke="{StaticResource CopperBrush}"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="2.7"
                                X1="29"
                                X2="29"
                                Y1="18"
                                Y2="50" />

                            <Line
                                Stroke="{StaticResource CopperBrush}"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="2.7"
                                X1="38"
                                X2="38"
                                Y1="18"
                                Y2="50" />

                            <Line
                                Stroke="{StaticResource CopperBrush}"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="2.7"
                                X1="46"
                                X2="46"
                                Y1="18"
                                Y2="50" />

                            <Rectangle
                                Canvas.Left="14"
                                Canvas.Top="24"
                                Width="38"
                                Height="20"
                                Fill="#455A64"
                                RadiusX="2"
                                RadiusY="2" />

                        </Canvas>
                    </Viewbox>
                    <TextBlock
                        Style="{StaticResource HeadlineText}"
                        Text="{Binding [PCB Manufacturing], Source={StaticResource Localization}}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,6,0"
                        Foreground="{DynamicResource TitleTextBrush}"
                        Text="EN" />
                    <ToggleButton
                        Margin="0,0,6,0"
                        IsChecked="{Binding IsRussian}"
                        Style="{StaticResource SwitchToggleStyle}"
                        ToolTip="English / Русский" />
                    <TextBlock
                        Margin="0,0,18,0"
                        Foreground="{DynamicResource TitleTextBrush}"
                        Text="RU" />

                    <TextBlock
                        MinWidth="70"
                        Margin="0,0,7,0"
                        Foreground="{DynamicResource TitleTextBrush}"
                        Text="{Binding [Dark theme], Source={StaticResource Localization}}" />
                    <ToggleButton
                        IsChecked="{Binding IsDarkTheme}"
                        Style="{StaticResource SwitchToggleStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem
                Content="{Binding PreferencesVm}"
                Validation.ErrorTemplate="{x:Null}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Rectangle
                            Width="8"
                            Height="8"
                            Margin="0,0,5,0"
                            Fill="{DynamicResource BlueBrush}" />
                        <TextBlock Text="{Binding [Preferences], Source={StaticResource Localization}}" />
                    </StackPanel>
                </TabItem.Header>
            </TabItem>

            <TabItem
                Content="{Binding QuoteVm}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse
                            Width="8"
                            Height="8"
                            Margin="0,0,5,0"
                            Fill="{DynamicResource CopperBrush}" />
                        <TextBlock Text="{Binding [Quote], Source={StaticResource Localization}}" />
                    </StackPanel>
                </TabItem.Header>

            </TabItem>

            <TabItem
                Content="{Binding OrderVm}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path
                            Width="9"
                            Height="9"
                            Margin="0,0,7,0"
                            Data="M 0,4 L 3,7 L 8,0"
                            Stretch="Fill"
                            Stroke="{DynamicResource SuccessBrush}"
                            StrokeThickness="1.8" />
                        <TextBlock Text="{Binding [Order], Source={StaticResource Localization}}" />
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
