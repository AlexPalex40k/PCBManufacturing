<UserControl
    x:Class="PCBManufacturing.Features.Order.OrderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Style="{StaticResource CommonBorder}">
            <StackPanel>
                <TextBlock
                    Style="{StaticResource HeadingText}"
                    Text="{Binding [Order Summary], Source={StaticResource Localization}}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,16,10"
                    Text="{Binding [Material], Source={StaticResource Localization}}" />

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,0,10"
                    FontWeight="SemiBold"
                    Text="{Binding Material, Mode=OneWay}" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,16,10"
                    Text="{Binding [Solder mask], Source={StaticResource Localization}}" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,0,0,10"
                    FontWeight="SemiBold"
                    Text="{Binding SolderMask, Mode=OneWay}" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,0,16,10"
                    Text="{Binding [Board thickness], Source={StaticResource Localization}}" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="0,0,0,10"
                    FontWeight="SemiBold"
                    Text="{Binding BoardThickness, Mode=OneWay}" />

                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    Margin="0,0,16,10"
                    Text="{Binding [Dimensions], Source={StaticResource Localization}}" />

                <TextBlock
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="0,0,0,10"
                    FontWeight="SemiBold"
                    Text="{Binding Dimensions, Mode=OneWay}" />

                <TextBlock
                    Grid.Row="4"
                    Grid.Column="0"
                    Margin="0,0,16,10"
                    Text="{Binding [Layers], Source={StaticResource Localization}}" />

                <TextBlock
                    Grid.Row="4"
                    Grid.Column="1"
                    Margin="0,0,0,10"
                    FontWeight="SemiBold"
                    Text="{Binding LayerCount, Mode=OneWay}" />

                <TextBlock
                    Grid.Row="5"
                    Grid.Column="0"
                    Margin="0,0,16,10"
                    Text="{Binding [Finish], Source={StaticResource Localization}}" />

                <TextBlock
                    Grid.Row="5"
                    Grid.Column="1"
                    Margin="0,0,0,10"
                    FontWeight="SemiBold"
                    Text="{Binding FinishType, Mode=OneWay}" />

                <TextBlock
                    Grid.Row="6"
                    Grid.Column="0"
                    Margin="0,0,16,0"
                    Text="{Binding [Postcode], Source={StaticResource Localization}}" />

                <TextBlock
                    Grid.Row="6"
                    Grid.Column="1"
                    FontWeight="SemiBold"
                    Text="{Binding Postcode, Mode=OneWay}" />

            </Grid>
                </StackPanel>
        </Border>

        <StackPanel
            Grid.Column="2"
            VerticalAlignment="Top">
            <TextBlock
                Style="{StaticResource SectionTitleStyle}"
                Text="{Binding [Ready to order], Source={StaticResource Localization}}" />

            <TextBlock
                Margin="0,10,0,20"
                Text="{Binding [Review the PCB configuration before placing the order], Source={StaticResource Localization}}"
                TextWrapping="Wrap" />

            <Button
                HorizontalAlignment="Left"
                Command="{Binding PlaceOrderCommand}"
                Content="{Binding [Place Order], Source={StaticResource Localization}}"
                Style="{StaticResource PrimaryButtonStyle}" />

        </StackPanel>
    </Grid>
</UserControl>