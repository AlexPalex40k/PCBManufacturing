<UserControl
    x:Class="PCBManufacturing.Features.Order.OrderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Style="{StaticResource SectionBorder}">
            <StackPanel>
                <TextBlock
                    Style="{StaticResource SectionTitleStyle}"
                    Text="{Binding [Order summary], Source={StaticResource Localization}}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource FormLabelTextStyle}"
                        Text="{Binding [Material], Source={StaticResource Localization}}" />

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource OrderValueTextStyle}"
                        Text="{Binding Material, Mode=OneWay}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource FormLabelTextStyle}"
                        Text="{Binding [Solder mask], Source={StaticResource Localization}}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource OrderValueTextStyle}"
                        Text="{Binding SolderMask, Mode=OneWay}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource FormLabelTextStyle}"
                        Text="{Binding [Board thickness], Source={StaticResource Localization}}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Style="{StaticResource OrderValueTextStyle}"
                        Text="{Binding BoardThickness, Mode=OneWay}" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Style="{StaticResource FormLabelTextStyle}"
                        Text="{Binding [Dimensions], Source={StaticResource Localization}}" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="1"
                        Style="{StaticResource OrderValueTextStyle}"
                        Text="{Binding Dimensions, Mode=OneWay}" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Style="{StaticResource FormLabelTextStyle}"
                        Text="{Binding [Layers], Source={StaticResource Localization}}" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="1"
                        Style="{StaticResource OrderValueTextStyle}"
                        Text="{Binding LayerCount, Mode=OneWay}" />

                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="0"
                        Style="{StaticResource FormLabelTextStyle}"
                        Text="{Binding [Surface finish], Source={StaticResource Localization}}" />

                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="1"
                        Style="{StaticResource OrderValueTextStyle}"
                        Text="{Binding SurfaceFinish, Mode=OneWay}" />

                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="0"
                        Style="{StaticResource FormLabelTextStyle}"
                        Text="{Binding [Postcode], Source={StaticResource Localization}}" />

                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="1"
                        Style="{StaticResource OrderValueTextStyle}"
                        Text="{Binding Postcode, Mode=OneWay}" />

                </Grid>
            </StackPanel>
        </Border>
        <StackPanel
            Grid.Column="2"
            Margin="10"
            VerticalAlignment="Top">
            <TextBlock
                Style="{StaticResource SectionTitleStyle}"
                Text="{Binding [Ready to order], Source={StaticResource Localization}}" />

            <TextBlock
                Margin="0,10,0,10"
                Text="{Binding [Review the PCB configuration before placing the order], Source={StaticResource Localization}}"
                TextWrapping="Wrap" />

            <TextBlock Margin="0,10,0,20">
                <Run Text="{Binding [Total price], Source={StaticResource Localization}, Mode=OneWay}" />
                <Run Text=":" />
                <Run Text="{Binding TotalPrice, StringFormat=€{0:N2}, Mode=OneWay}" />
            </TextBlock>

            <Button
                HorizontalAlignment="Left"
                Command="{Binding PlaceOrderCommand}"
                Content="{Binding [Place Order], Source={StaticResource Localization}}"
                Style="{StaticResource PrimaryButtonStyle}" />

        </StackPanel>
    </Grid>
</UserControl>