<UserControl x:Class="PCBManufacturing.Features.Preferences.PreferencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Margin="0,0,16,12"
                   VerticalAlignment="Center"
                   Text="Material" />

        <ComboBox Grid.Row="0"
                  Grid.Column="1"
                  Margin="0,0,0,12"
                  ItemsSource="{Binding Materials}"
                  SelectedItem="{Binding SelectedMaterial}"
                  DisplayMemberPath="Name" />

        <Border Grid.Row="0"
                Grid.RowSpan="4"
                Grid.Column="2"
                Margin="40,0,0,0"
                Padding="16"
                BorderBrush="Gray"
                BorderThickness="1">

            <StackPanel>
                <TextBlock Margin="0,0,0,16"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="Summary" />

                <TextBlock Margin="0,0,0,6">
                    <Run Text="Material: " />
                    <Run Text="{Binding SelectedMaterial.Name, Mode=OneWay}" />
                </TextBlock>

                <TextBlock Margin="0,0,0,6">
                    <Run Text="Solder mask: " />
                    <Run Text="{Binding SelectedSolderMaskColor.Name, Mode=OneWay}" />
                </TextBlock>

                <TextBlock Margin="0,0,0,6">
                    <Run Text="Thickness: " />
                    <Run Text="{Binding SelectedBoardThickness.Name, Mode=OneWay}" />
                </TextBlock>

                <TextBlock Margin="0,0,0,6">
                    <Run Text="Price modifier: ×" />
                    <Run Text="{Binding PriceModifier, Mode=OneWay}" />
                </TextBlock>

                <TextBlock>
                    <Run Text="Production time: " />
                    <Run Text="{Binding ProductionDays, Mode=OneWay}" />
                    <Run Text=" days" />
                </TextBlock>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Margin="0,0,16,12"
                   VerticalAlignment="Center"
                   Text="Solder mask" />

        <ComboBox Grid.Row="1"
                  Grid.Column="1"
                  Margin="0,0,0,12"
                  ItemsSource="{Binding SolderMaskColors}"
                  SelectedItem="{Binding SelectedSolderMaskColor}"
                  DisplayMemberPath="Name" />

        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   Margin="0,0,16,12"
                   VerticalAlignment="Center"
                   Text="Board thickness" />

        <ComboBox Grid.Row="2"
                  Grid.Column="1"
                  Margin="0,0,0,12"
                  ItemsSource="{Binding BoardThicknesses}"
                  SelectedItem="{Binding SelectedBoardThickness}"
                  DisplayMemberPath="Name" />

        <TextBlock Grid.Row="3"
                   Grid.Column="0"
                   Margin="0,0,16,0"
                   VerticalAlignment="Center"
                   Text="Postcode" />

        <TextBox Grid.Row="3"
                 Grid.Column="1"
                 Text="{Binding Postcode,
                        UpdateSourceTrigger=PropertyChanged,
                        ValidatesOnNotifyDataErrors=True}" />
    </Grid>

</UserControl>