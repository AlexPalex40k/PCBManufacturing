<UserControl x:Class="PCBManufacturing.Features.Preferences.PreferencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Margin="0,0,16,12"
                   VerticalAlignment="Center"
                   Text="Material" />

        <ComboBox Grid.Row="0"
                  Grid.Column="1"
                  Margin="0,0,0,12"
                  ItemsSource="{Binding Materials}"
                  SelectedItem="{Binding SelectedMaterial}"
                  DisplayMemberPath="Name" />

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Margin="0,0,16,12"
                   VerticalAlignment="Center"
                   Text="Solder mask" />

        <ComboBox Grid.Row="1"
                  Grid.Column="1"
                  Margin="0,0,0,12"
                  ItemsSource="{Binding SolderMaskColors}"
                  SelectedItem="{Binding SelectedSolderMaskColor}"
                  DisplayMemberPath="Name" />

        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   Margin="0,0,16,12"
                   VerticalAlignment="Center"
                   Text="Board thickness" />

        <ComboBox Grid.Row="2"
                  Grid.Column="1"
                  Margin="0,0,0,12"
                  ItemsSource="{Binding BoardThicknesses}"
                  SelectedItem="{Binding SelectedBoardThickness}"
                  DisplayMemberPath="Name" />

        <TextBlock Grid.Row="3"
                   Grid.Column="0"
                   Margin="0,0,16,0"
                   VerticalAlignment="Center"
                   Text="Postcode" />

        <TextBox Grid.Row="3"
                 Grid.Column="1"
                 Text="{Binding Postcode, UpdateSourceTrigger=PropertyChanged}" />
    </Grid>

</UserControl>