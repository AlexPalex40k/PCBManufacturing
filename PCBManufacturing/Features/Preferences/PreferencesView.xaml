<UserControl
    x:Class="PCBManufacturing.Features.Preferences.PreferencesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,0,16,12"
            VerticalAlignment="Center"
            Text="{Binding [Material], Source={StaticResource Localization}}" />

        <ComboBox
            Grid.Row="0"
            Grid.Column="1"
            Margin="0,0,0,12"
            DisplayMemberPath="Name"
            ItemsSource="{Binding Materials}"
            SelectedItem="{Binding SelectedMaterial}"/>

        <Border
            Grid.Row="0"
            Grid.RowSpan="4"
            Grid.Column="2"
            Margin="40,0,0,0"
            Padding="16"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">

            <StackPanel>
                <TextBlock
                    Margin="0,0,0,16"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="{Binding [Summary], Source={StaticResource Localization}}" />

                <TextBlock Margin="0,0,0,6">
                    <Run Text="{Binding [Material], Source={StaticResource Localization}, Mode=OneWay}" />
                    <Run Text=": " />
                    <Run Text="{Binding SelectedMaterial.Name, Mode=OneWay}" />
                </TextBlock>

                <TextBlock Margin="0,0,0,6">
                    <Run Text="{Binding [Solder mask], Source={StaticResource Localization}, Mode=OneWay}" />
                    <Run Text=": " />
                    <Run Text="{Binding SelectedSolderMaskColor.Name, Mode=OneWay}" />
                </TextBlock>

                <TextBlock Margin="0,0,0,6">
                    <Run Text="{Binding [Board thickness], Source={StaticResource Localization}, Mode=OneWay}" />
                    <Run Text=": " />
                    <Run Text="{Binding SelectedBoardThickness.Name, Mode=OneWay}" />
                </TextBlock>

                <TextBlock Margin="0,0,0,6">
                    <Run Text="{Binding [Price modifier], Source={StaticResource Localization}, Mode=OneWay}" />
                    <Run Text=": ×" />
                    <Run Text="{Binding PriceModifier, Mode=OneWay}" />
                </TextBlock>

                <TextBlock>
                    <Run Text="{Binding [Production time], Source={StaticResource Localization}, Mode=OneWay}" />
                    <Run Text=": " />
                    <Run Text="{Binding ProductionDays, Mode=OneWay}" />
                    <Run Text="{Binding [days],
                    Source={StaticResource Localization},
                    Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,0,16,12"
            VerticalAlignment="Center"
            Text="{Binding [Solder mask], Source={StaticResource Localization}}" />

        <ComboBox
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,0,0,12"
            DisplayMemberPath="Name"
            ItemsSource="{Binding SolderMaskColors}"
            SelectedItem="{Binding SelectedSolderMaskColor}" />

        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            Margin="0,0,16,12"
            VerticalAlignment="Center"
            Text="{Binding [Board thickness], Source={StaticResource Localization}}" />

        <ComboBox
            Grid.Row="2"
            Grid.Column="1"
            Margin="0,0,0,12"
            DisplayMemberPath="Name"
            ItemsSource="{Binding BoardThicknesses}"
            SelectedItem="{Binding SelectedBoardThickness}" />

        <TextBlock
            Grid.Row="3"
            Grid.Column="0"
            Margin="0,0,16,0"
            VerticalAlignment="Center"
            Text="{Binding [Postcode], Source={StaticResource Localization}}" />

        <TextBox
            Grid.Row="3"
            Grid.Column="1"
            Text="{Binding Postcode, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
    </Grid>

</UserControl>