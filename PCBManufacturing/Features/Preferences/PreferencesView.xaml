<UserControl
    x:Class="PCBManufacturing.Features.Preferences.PreferencesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Style="{StaticResource CommonBorder}">
            <StackPanel>
                <TextBlock
                    Style="{StaticResource SectionTitleStyle}"
                    Text="{Binding [Board preferences], Source={StaticResource Localization}}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,16,10"
                        VerticalAlignment="Center"
                        Text="{Binding [Material], Source={StaticResource Localization}}" />

                    <ComboBox
                        Grid.Row="0"
                        Grid.Column="2"
                        Margin="0,0,0,10"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding Materials}"
                        SelectedItem="{Binding SelectedMaterial}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,0,16,10"
                        VerticalAlignment="Center"
                        Text="{Binding [Solder mask], Source={StaticResource Localization}}" />

                    <ComboBox
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="0,0,0,10"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding SolderMaskColors}"
                        SelectedItem="{Binding SelectedSolderMaskColor}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="0,0,16,10"
                        VerticalAlignment="Center"
                        Text="{Binding [Board thickness], Source={StaticResource Localization}}" />

                    <ComboBox
                        Grid.Row="2"
                        Grid.Column="2"
                        Margin="0,0,0,10"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding BoardThicknesses}"
                        SelectedItem="{Binding SelectedBoardThickness}" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        Text="{Binding [Postcode], Source={StaticResource Localization}}" />

                    <TextBox
                        x:Name="PostcodeTextBox"
                        Grid.Row="3"
                        Grid.Column="2"
                        Text="{Binding Postcode, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="2"
                        Style="{StaticResource ValidationErrorTextStyle}"
                        Text="{Binding ElementName=PostcodeTextBox, Path=(Validation.Errors)[0].ErrorContent}"/>
                </Grid>
            </StackPanel>
        </Border>
        <Border
            Grid.Column="2"
            Style="{StaticResource CommonBorder}">

            <StackPanel>
                <TextBlock
                    Style="{StaticResource SectionTitleStyle}"
                    Text="{Binding [Summary], Source={StaticResource Localization}}" />

                <TextBlock Margin="0,0,0,6">
                    <Run Text="{Binding [Material], Source={StaticResource Localization}, Mode=OneWay}" />
                    <Run Text=": " />
                    <Run Text="{Binding SelectedMaterial.Name, Mode=OneWay}" />
                </TextBlock>

                <TextBlock Margin="0,0,0,6">
                    <Run Text="{Binding [Solder mask], Source={StaticResource Localization}, Mode=OneWay}" />
                    <Run Text=": " />
                    <Run Text="{Binding SelectedSolderMaskColor.Name, Mode=OneWay}" />
                </TextBlock>

                <TextBlock Margin="0,0,0,6">
                    <Run Text="{Binding [Board thickness], Source={StaticResource Localization}, Mode=OneWay}" />
                    <Run Text=": " />
                    <Run Text="{Binding SelectedBoardThickness.Name, Mode=OneWay}" />
                </TextBlock>

                <TextBlock Margin="0,0,0,6">
                    <Run Text="{Binding [Price modifier], Source={StaticResource Localization}, Mode=OneWay}" />
                    <Run Text=": ×" />
                    <Run Text="{Binding PriceModifier, Mode=OneWay}" />
                </TextBlock>

                <TextBlock>
                    <Run Text="{Binding [Production time], Source={StaticResource Localization}, Mode=OneWay}" />
                    <Run Text=": " />
                    <Run Text="{Binding ProductionDays, Mode=OneWay}" />
                    <Run Text="{Binding [days], Source={StaticResource Localization}, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Border>

    </Grid>

</UserControl>
