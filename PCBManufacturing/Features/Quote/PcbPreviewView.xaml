<UserControl
    x:Class="PCBManufacturing.Features.Quote.PcbPreviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Viewbox
        Margin="10"
        Stretch="Uniform">

        <Grid
            Width="{Binding PreviewWidth, Mode=OneWay}"
            Height="{Binding PreviewHeight, Mode=OneWay}">

            <!-- PCB -->
            <Border
                Background="{Binding SolderMaskColorCode, Mode=OneWay}"
                BorderBrush="#315F42"
                BorderThickness="3"
                CornerRadius="8">

                <Border
                    Margin="8"
                    BorderBrush="#45FFFFFF"
                    BorderThickness="2"
                    CornerRadius="5" />

            </Border>

            <!-- Mounting holes -->
            <Ellipse
                Width="18"
                Height="18"
                Margin="20"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Fill="#F0F0F0"
                Stroke="#45504A"
                StrokeThickness="4" />

            <Ellipse
                Width="18"
                Height="18"
                Margin="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Fill="#F0F0F0"
                Stroke="#45504A"
                StrokeThickness="4" />

            <Ellipse
                Width="18"
                Height="18"
                Margin="20"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Fill="#F0F0F0"
                Stroke="#45504A"
                StrokeThickness="4" />

            <Ellipse
                Width="18"
                Height="18"
                Margin="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Fill="#F0F0F0"
                Stroke="#45504A"
                StrokeThickness="4" />

            <!-- PCB content -->
            <Grid Margin="55">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    VerticalAlignment="Center">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                    </Grid.ColumnDefinitions>

                    <Ellipse
                        Grid.Column="0"
                        Width="14"
                        Height="14"
                        Fill="{Binding SolderMaskColorCode, Mode=OneWay}"
                        Stroke="#E2C457"
                        StrokeThickness="3" />

                    <Rectangle
                        Grid.Column="1"
                        Height="3"
                        VerticalAlignment="Center"
                        Fill="#E2C457" />

                    <Ellipse
                        Grid.Column="2"
                        Width="14"
                        Height="14"
                        Fill="{Binding SolderMaskColorCode, Mode=OneWay}"
                        Stroke="#E2C457"
                        StrokeThickness="3" />

                </Grid>

                <Grid
                    Grid.Row="1"
                    Grid.Column="1"
                    Width="90"
                    Height="60"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                    <!-- IC body -->
                    <Rectangle
                        Margin="14,5"
                        Fill="#262626"
                        Stroke="#E2C457"
                        StrokeThickness="2"
                        RadiusX="3"
                        RadiusY="3" />

                    <!-- Left pins -->
                    <Rectangle
                        Width="14"
                        Height="6"
                        Margin="0,13,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Fill="#E2C457" />

                    <Rectangle
                        Width="14"
                        Height="6"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Fill="#E2C457" />

                    <Rectangle
                        Width="14"
                        Height="6"
                        Margin="0,0,0,13"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Fill="#E2C457" />

                    <!-- Right pins -->
                    <Rectangle
                        Width="14"
                        Height="6"
                        Margin="0,13,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Fill="#E2C457" />

                    <Rectangle
                        Width="14"
                        Height="6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Fill="#E2C457" />

                    <Rectangle
                        Width="14"
                        Height="6"
                        Margin="0,0,0,13"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Fill="#E2C457" />

                </Grid>

                <Grid
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    VerticalAlignment="Center">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                    </Grid.ColumnDefinitions>

                    <Ellipse
                        Grid.Column="0"
                        Width="14"
                        Height="14"
                        Fill="{Binding SolderMaskColorCode, Mode=OneWay}"
                        Stroke="#E2C457"
                        StrokeThickness="3" />

                    <Rectangle
                        Grid.Column="1"
                        Height="3"
                        VerticalAlignment="Center"
                        Fill="#E2C457" />

                    <Ellipse
                        Grid.Column="2"
                        Width="14"
                        Height="14"
                        Fill="{Binding SolderMaskColorCode, Mode=OneWay}"
                        Stroke="#E2C457"
                        StrokeThickness="3" />

                </Grid>

            </Grid>

            <!-- PCB label -->
            <TextBlock
                Margin="50,0,0,20"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                FontSize="11"
                FontWeight="SemiBold"
                Foreground="#BFE5C7"
                Text="{Binding BoardLabel, Mode=OneWay}" />

        </Grid>

    </Viewbox>

</UserControl>