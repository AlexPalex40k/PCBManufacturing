<UserControl
    x:Class="PCBManufacturing.Features.Quote.QuoteView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <GroupBox
            Grid.Column="0"
            Header="{Binding [Parameters], Source={StaticResource Localization}}">

            <DataGrid
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding Parameters}">

                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Group}"
                        Header="{Binding [Group], Source={StaticResource Localization}}" />

                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Name}"
                        Header="{Binding [Parameter], Source={StaticResource Localization}}" />

                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Value}"
                        Header="{Binding [Value], Source={StaticResource Localization}}" />
                </DataGrid.Columns>

            </DataGrid>
        </GroupBox>

        <GroupBox
            Grid.Column="2"
            Header="{Binding [PCB Preview], Source={StaticResource Localization}}">

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,10"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Text="{Binding BoardDimensions, Mode=OneWay}" />

                <Viewbox
                    Grid.Row="1"
                    Margin="20"
                    Stretch="Uniform">

                    <Canvas
                        Width="520"
                        Height="300">

                        <!--  PCB substrate  -->
                        <Border
                            Canvas.Left="20"
                            Canvas.Top="25"
                            Width="480"
                            Height="250"
                            Background="{Binding SolderMaskColorCode, Mode=OneWay}"
                            BorderBrush="#315F42"
                            BorderThickness="3"
                            CornerRadius="8">

                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="10"
                                    Direction="270"
                                    Opacity="0.25"
                                    ShadowDepth="6" />
                            </Border.Effect>
                        </Border>

                        <!--  Inner PCB border  -->
                        <Border
                            Canvas.Left="28"
                            Canvas.Top="33"
                            Width="464"
                            Height="234"
                            BorderBrush="#45FFFFFF"
                            BorderThickness="2"
                            CornerRadius="5" />

                        <!--  Mounting holes  -->
                        <Ellipse
                            Canvas.Left="42"
                            Canvas.Top="47"
                            Width="18"
                            Height="18"
                            Fill="#F0F0F0"
                            Stroke="#45504A"
                            StrokeThickness="3" />

                        <Ellipse
                            Canvas.Left="460"
                            Canvas.Top="47"
                            Width="18"
                            Height="18"
                            Fill="#F0F0F0"
                            Stroke="#45504A"
                            StrokeThickness="3" />

                        <Ellipse
                            Canvas.Left="42"
                            Canvas.Top="235"
                            Width="18"
                            Height="18"
                            Fill="#F0F0F0"
                            Stroke="#45504A"
                            StrokeThickness="3" />

                        <Ellipse
                            Canvas.Left="460"
                            Canvas.Top="235"
                            Width="18"
                            Height="18"
                            Fill="#F0F0F0"
                            Stroke="#45504A"
                            StrokeThickness="3" />

                        <!--  Copper traces  -->

                        <!--  Top-left -> center  -->
                        <Path
                            Data="M 95,70  L 170,70  L 205,100  L 256,100"
                            Stroke="#E2C457"
                            StrokeLineJoin="Round"
                            StrokeThickness="3" />

                        <!--  Top center -> right  -->
                        <Path
                            Data="M 265,70  L 355,70  L 385,100  L 420,100"
                            Stroke="#E2C457"
                            StrokeLineJoin="Round"
                            StrokeThickness="3" />

                        <Path
                            Data="M 90,110  L 90,150  L 130,170  L 130,195"
                            Stroke="#E2C457"
                            StrokeLineJoin="Round"
                            StrokeThickness="3" />

                        <Path
                            Data="M 330,137 L 420,137"
                            Stroke="#E2C457"
                            StrokeLineJoin="Round"
                            StrokeThickness="3" />

                        <Path
                            Data="M 75,220  L 190,220  L 210,245"
                            Stroke="#E2C457"
                            StrokeLineJoin="Round"
                            StrokeThickness="3" />

                        <Path
                            Data="M 270,245  L 340,170  L 420,170"
                            Stroke="#E2C457"
                            StrokeLineJoin="Round"
                            StrokeThickness="3" />

                        <Path
                            Data="M 295,245  L 340,202  L 420,202"
                            Stroke="#E2C457"
                            StrokeLineJoin="Round"
                            StrokeThickness="3" />

                        <Ellipse
                            Canvas.Left="84"
                            Canvas.Top="64"
                            Width="12"
                            Height="12"
                            Fill="{Binding SolderMaskColorCode, Mode=OneWay}"
                            Stroke="#E2C457"
                            StrokeThickness="3" HorizontalAlignment="Center" VerticalAlignment="Top" />

                        <Ellipse
                            Canvas.Left="255"
                            Canvas.Top="94"
                            Width="12"
                            Height="12"
                            Fill="{Binding SolderMaskColorCode, Mode=OneWay}"
                            Stroke="#E2C457"
                            StrokeThickness="3" HorizontalAlignment="Left" VerticalAlignment="Center" />

                        <Ellipse
                            Canvas.Left="255"
                            Canvas.Top="64"
                            Width="12"
                            Height="12"
                            Fill="{Binding SolderMaskColorCode, Mode=OneWay}"
                            Stroke="#E2C457"
                            StrokeThickness="3" />

                        <Ellipse
                            Canvas.Left="418"
                            Canvas.Top="94"
                            Width="12"
                            Height="12"
                            Fill="{Binding SolderMaskColorCode, Mode=OneWay}"
                            Stroke="#E2C457"
                            StrokeThickness="3" />

                        <Ellipse
                            Canvas.Left="84"
                            Canvas.Top="100"
                            Width="12"
                            Height="12"
                            Fill="{Binding SolderMaskColorCode, Mode=OneWay}"
                            Stroke="#E2C457"
                            StrokeThickness="3" />

                        <Ellipse
                            Canvas.Left="124"
                            Canvas.Top="194"
                            Width="12"
                            Height="12"
                            Fill="{Binding SolderMaskColorCode, Mode=OneWay}"
                            Stroke="#E2C457"
                            StrokeThickness="3"/>

                        <Ellipse
                            Canvas.Left="66"
                            Canvas.Top="214"
                            Width="12"
                            Height="12"
                            Fill="{Binding SolderMaskColorCode, Mode=OneWay}"
                            Stroke="#E2C457"
                            StrokeThickness="3" />

                        <Ellipse
                            Canvas.Left="321"
                            Canvas.Top="131"
                            Width="12"
                            Height="12"
                            Fill="{Binding SolderMaskColorCode, Mode=OneWay}"
                            Stroke="#E2C457"
                            StrokeThickness="3" />

                        <Ellipse
                            Canvas.Left="418"
                            Canvas.Top="164"
                            Width="12"
                            Height="12"
                            Fill="{Binding SolderMaskColorCode, Mode=OneWay}"
                            Stroke="#E2C457"
                            StrokeThickness="3" HorizontalAlignment="Center" VerticalAlignment="Top" />

                        <Ellipse
                            Canvas.Left="418"
                            Canvas.Top="196"
                            Width="12"
                            Height="12"
                            Fill="{Binding SolderMaskColorCode, Mode=OneWay}"
                            Stroke="#E2C457"
                            StrokeThickness="3" HorizontalAlignment="Center" VerticalAlignment="Top" />

                        <Ellipse
                            Canvas.Left="418"
                            Canvas.Top="131"
                            Width="12"
                            Height="12"
                            Fill="{Binding SolderMaskColorCode, Mode=OneWay}"
                            Stroke="#E2C457"
                            StrokeThickness="3" HorizontalAlignment="Center" VerticalAlignment="Top" />

                        <!--  Small IC  -->
                        <Rectangle
                            Canvas.Left="225"
                            Canvas.Top="128"
                            Width="62"
                            Height="42"
                            Fill="#262626"
                            RadiusX="3"
                            RadiusY="3"
                            Stroke="#E2C457"
                            StrokeThickness="2" />

                        <!--  IC pins  -->
                        <Rectangle
                            Canvas.Left="216"
                            Canvas.Top="134"
                            Width="10"
                            Height="5"
                            Fill="#E2C457" />

                        <Rectangle
                            Canvas.Left="216"
                            Canvas.Top="146"
                            Width="10"
                            Height="5"
                            Fill="#E2C457" />

                        <Rectangle
                            Canvas.Left="216"
                            Canvas.Top="158"
                            Width="10"
                            Height="5"
                            Fill="#E2C457" />

                        <Rectangle
                            Canvas.Left="286"
                            Canvas.Top="134"
                            Width="10"
                            Height="5"
                            Fill="#E2C457" />

                        <Rectangle
                            Canvas.Left="286"
                            Canvas.Top="146"
                            Width="10"
                            Height="5"
                            Fill="#E2C457" />

                        <Rectangle
                            Canvas.Left="286"
                            Canvas.Top="158"
                            Width="10"
                            Height="5"
                            Fill="#E2C457" />

                        <!--  Bottom connector pads  -->
                        <Rectangle
                            Canvas.Left="200"
                            Canvas.Top="240"
                            Width="20"
                            Height="24"
                            Fill="#E2C457" />

                        <Rectangle
                            Canvas.Left="230"
                            Canvas.Top="240"
                            Width="20"
                            Height="24"
                            Fill="#E2C457" />

                        <Rectangle
                            Canvas.Left="260"
                            Canvas.Top="240"
                            Width="20"
                            Height="24"
                            Fill="#E2C457" />

                        <Rectangle
                            Canvas.Left="290"
                            Canvas.Top="240"
                            Width="20"
                            Height="24"
                            Fill="#E2C457" />

                        <!--  PCB label  -->
                        <TextBlock
                            Canvas.Left="70"
                            Canvas.Top="242"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#BFE5C7"
                            Text="{Binding [PCB1], Source={StaticResource Localization}}" />

                    </Canvas>
                </Viewbox>

                <TextBlock
                    Grid.Row="2"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Text="{Binding BoardDetails, Mode=OneWay}" />

            </Grid>
        </GroupBox>

    </Grid>

</UserControl>