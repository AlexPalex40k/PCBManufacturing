<UserControl
    x:Class="PCBManufacturing.Features.Quote.QuoteView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:quote="clr-namespace:PCBManufacturing.Features.Quote">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Style="{StaticResource SectionBorder}">
            <StackPanel>
                <TextBlock
                    Style="{StaticResource SectionTitleStyle}"
                    Text="{Binding [Parameters], Source={StaticResource Localization}}" />

                <DataGrid
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    ItemsSource="{Binding ParametersView}"
                    VirtualizingPanel.IsVirtualizingWhenGrouping="True">

                    <DataGrid.GroupStyle>
                        <GroupStyle ContainerStyle="{StaticResource DataGridGroupItemStyle}" />
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>

                        <DataGridTextColumn
                            Width="*"
                            ElementStyle="{StaticResource DataGridIndentedTextStyle}"
                            Header="{Binding [Parameter], Source={StaticResource Localization}}">
                            <DataGridTextColumn.Binding>
                                <MultiBinding
                                    Converter="{StaticResource LocalizationConverter}"
                                    Mode="OneWay">
                                    <Binding Path="NameKey" />
                                    <Binding
                                        Path="CurrentCulture"
                                        Source="{StaticResource Localization}" />
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn
                            Width="*"
                            Header="{Binding [Value], Source={StaticResource Localization}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock
                                            x:Name="ReadOnlyValue"
                                            Style="{StaticResource DataGridIndentedTextStyle}"
                                            Text="{Binding Value}" />

                                        <StackPanel
                                            x:Name="WidthEditor"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Visibility="Collapsed">
                                            <TextBox
                                                Style="{StaticResource DataGridValueTextBoxStyle}"
                                                KeyDown="BoardValueTextBox_OnKeyDown"
                                                Text="{Binding DataContext.Width, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}" />
                                            <TextBlock
                                                Style="{StaticResource DataGridUnitTextStyle}"
                                                Text="mm" />
                                        </StackPanel>

                                        <StackPanel
                                            x:Name="HeightEditor"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Visibility="Collapsed">
                                            <TextBox
                                                Style="{StaticResource DataGridValueTextBoxStyle}"
                                                KeyDown="BoardValueTextBox_OnKeyDown"
                                                Text="{Binding DataContext.Height, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}" />
                                            <TextBlock
                                                Style="{StaticResource DataGridUnitTextStyle}"
                                                Text="mm" />
                                        </StackPanel>

                                        <TextBox
                                            x:Name="LayerCountEditor"
                                            Style="{StaticResource DataGridValueTextBoxStyle}"
                                            KeyDown="BoardValueTextBox_OnKeyDown"
                                            Text="{Binding DataContext.LayerCount, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True}"
                                            Visibility="Collapsed" />
                                    </Grid>

                                    <DataTemplate.Triggers>
                                        <DataTrigger
                                            Binding="{Binding NameKey}"
                                            Value="Width">
                                            <Setter TargetName="ReadOnlyValue" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="WidthEditor" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger
                                            Binding="{Binding NameKey}"
                                            Value="Height">
                                            <Setter TargetName="ReadOnlyValue" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="HeightEditor" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger
                                            Binding="{Binding NameKey}"
                                            Value="Layer count">
                                            <Setter TargetName="ReadOnlyValue" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="LayerCountEditor" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <Border
            Grid.Column="2"
            ClipToBounds="True"
            Style="{StaticResource SectionBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Style="{StaticResource SectionTitleStyle}"
                    Text="{Binding [PCB Preview], Source={StaticResource Localization}}" />

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Style="{StaticResource PreviewText}"
                        Text="{Binding BoardDimensions, Mode=OneWay}" />

                    <quote:PcbPreviewView Grid.Row="1" />

                    <TextBlock
                        Grid.Row="2"
                        Style="{StaticResource PreviewText}"
                        Text="{Binding BoardDetails, Mode=OneWay}" />

                </Grid>
            </Grid>
        </Border>

    </Grid>

</UserControl>
