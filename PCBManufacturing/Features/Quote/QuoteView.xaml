<UserControl
    x:Class="PCBManufacturing.Features.Quote.QuoteView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:quote="clr-namespace:PCBManufacturing.Features.Quote">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Style="{StaticResource CommonBorder}">
            <StackPanel>
                <TextBlock
                    Style="{StaticResource SectionTitleStyle}"
                    Text="{Binding [Parameters], Source={StaticResource Localization}}" />

                <DataGrid
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    ItemsSource="{Binding ParametersView}"
                    VirtualizingPanel.IsVirtualizingWhenGrouping="True">

                    <DataGrid.Columns>

                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Name}"
                            ElementStyle="{StaticResource DataGridIndentedTextStyle}"
                            Header="{Binding [Parameter], Source={StaticResource Localization}}" />

                        <DataGridTemplateColumn
                            Width="2*"
                            Header="{Binding [Value], Source={StaticResource Localization}}">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock
                                            x:Name="ReadOnlyValue"
                                            VerticalAlignment="Center"
                                            Text="{Binding Value}" />
                                        <TextBox
                                            x:Name="EditableValue"
                                            Height="24"
                                            Padding="4,0"
                                            VerticalContentAlignment="Center"
                                            Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Visibility="Collapsed" />

                                    </Grid>

                                    <DataTemplate.Triggers>

                                        <DataTrigger
                                            Binding="{Binding IsEditable}"
                                            Value="True">

                                            <Setter TargetName="ReadOnlyValue" Property="Visibility" Value="Collapsed" />

                                            <Setter TargetName="EditableValue" Property="Visibility" Value="Visible" />

                                        </DataTrigger>

                                    </DataTemplate.Triggers>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Price, StringFormat=€{0:N2}}"
                            Header="{Binding [Price], Source={StaticResource Localization}}"
                            IsReadOnly="True" />

                    </DataGrid.Columns>

                </DataGrid>
            </StackPanel>
        </Border>

        <Border
            Grid.Column="2"
            ClipToBounds="True"
            Style="{StaticResource CommonBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Style="{StaticResource SectionTitleStyle}"
                    Text="{Binding [PCB Preview], Source={StaticResource Localization}}" />

                <Grid
                    x:Name="ThisGrid"
                    Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Style="{StaticResource PreviewText}"
                        Text="{Binding BoardDimensions, Mode=OneWay}" />

                    <quote:PcbPreviewView Grid.Row="1" />

                    <TextBlock
                        Grid.Row="2"
                        Style="{StaticResource PreviewText}"
                        Text="{Binding BoardDetails, Mode=OneWay}" />

                </Grid>
            </Grid>
        </Border>

    </Grid>

</UserControl>
