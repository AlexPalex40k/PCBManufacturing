<Application
    x:Class="PCBManufacturing.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="clr-namespace:PCBManufacturing.Services">
    <Application.Resources>
        <ResourceDictionary>
            <ObjectDataProvider 
                x:Key="Localization"
                ObjectInstance="{x:Static services:LocalizationManager.Instance}" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Themes/Colors.Light.xaml" />
                <ResourceDictionary Source="Resources/Themes/Typography.xaml" />
                <ResourceDictionary Source="Resources/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
