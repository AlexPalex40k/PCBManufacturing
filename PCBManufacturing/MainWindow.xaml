<Window
    x:Class="PCBManufacturing.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:order="clr-namespace:PCBManufacturing.Features.Order"
    xmlns:preferences="clr-namespace:PCBManufacturing.Features.Preferences"
    xmlns:quote="clr-namespace:PCBManufacturing.Features.Quote"
    Title="PCB Manufacturing"
    MinWidth="800"
    MinHeight="500"
    Background="{DynamicResource WindowBackgroundBrush}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <DataTemplate DataType="{x:Type preferences:PreferencesViewModel}">
            <preferences:PreferencesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type quote:QuoteViewModel}">
            <quote:QuoteView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type order:OrderViewModel}">
            <order:OrderView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="12,8"
            HorizontalAlignment="Right"
            Orientation="Horizontal">

            <TextBlock
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Text="Dark theme" />

            <CheckBox
                VerticalAlignment="Center"
                IsChecked="{Binding IsDarkTheme}" />

        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Preferences">
                <ContentControl
                    Content="{Binding Preferences}"
                    Validation.ErrorTemplate="{x:Null}" />
            </TabItem>

            <TabItem Header="Quote">
                <ContentControl Content="{Binding Quote}" />
            </TabItem>

            <TabItem Header="Order">
                <ContentControl Content="{Binding Order}" />
            </TabItem>
        </TabControl>

    </Grid>
</Window>
