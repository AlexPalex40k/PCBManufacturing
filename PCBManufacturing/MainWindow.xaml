<Window
    x:Class="PCBManufacturing.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:order="clr-namespace:PCBManufacturing.Features.Order"
    xmlns:preferences="clr-namespace:PCBManufacturing.Features.Preferences"
    xmlns:quote="clr-namespace:PCBManufacturing.Features.Quote"
    Title="PCB Manufacturing"
    MinWidth="800"
    MinHeight="500"
    Background="{DynamicResource WindowBackgroundBrush}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <DataTemplate DataType="{x:Type preferences:PreferencesViewModel}">
            <preferences:PreferencesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type quote:QuoteViewModel}">
            <quote:QuoteView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type order:OrderViewModel}">
            <order:OrderView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="10,5"
            Background="{DynamicResource TitleBarBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="20"
                        Height="20"
                        Margin="0,0,9,0"
                        VerticalAlignment="Center"
                        BorderBrush="#65CDEB"
                        BorderThickness="1">
                        <Grid>
                            <Rectangle
                                Width="10"
                                Height="10"
                                Stroke="#65CDEB"
                                StrokeThickness="1" />
                            <Ellipse
                                Width="3"
                                Height="3"
                                Fill="#65CDEB" />
                        </Grid>
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TitleTextBrush}"
                        Text="PCB MANUFACTURING" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,6,0"
                        Foreground="{DynamicResource TitleTextBrush}"
                        Text="EN" />
                    <ToggleButton
                        Margin="0,0,6,0"
                        IsChecked="{Binding IsRussian}"
                        Style="{StaticResource SwitchToggleStyle}"
                        ToolTip="English / Русский" />
                    <TextBlock
                        Margin="0,0,18,0"
                        Foreground="{DynamicResource TitleTextBrush}"
                        Text="RU" />

                    <TextBlock
                        Margin="0,0,7,0"
                        MinWidth="70"
                        Foreground="{DynamicResource TitleTextBrush}"
                        Text="{Binding [Dark theme], Source={StaticResource Localization}}" />
                    <ToggleButton
                        IsChecked="{Binding IsDarkTheme}"
                        Style="{StaticResource SwitchToggleStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Rectangle
                            Width="8"
                            Height="8"
                            Margin="0,0,5,0"
                            Fill="{DynamicResource BlueBrush}" />
                        <TextBlock Text="{Binding [Preferences], Source={StaticResource Localization}}" />
                    </StackPanel>
                </TabItem.Header>

                <ContentControl
                    Content="{Binding Preferences}"
                    Validation.ErrorTemplate="{x:Null}" />
            </TabItem>

            <TabItem >
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse
                            Width="8"
                            Height="8"
                            Margin="0,0,5,0"
                            Fill="{DynamicResource CopperBrush}" />
                        <TextBlock Text="{Binding [Quote], Source={StaticResource Localization}}" />
                    </StackPanel>
                </TabItem.Header>
                <ContentControl Content="{Binding Quote}" />
            </TabItem>

            <TabItem >
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path
                            Width="9"
                            Height="9"
                            Margin="0,0,7,0"
                            Data="M 0,4 L 3,7 L 8,0"
                            Stretch="Fill"
                            Stroke="{DynamicResource SuccessBrush}"
                            StrokeThickness="1.8" />
                        <TextBlock Text="{Binding [Order], Source={StaticResource Localization}}" />
                    </StackPanel>
                </TabItem.Header>
                <ContentControl Content="{Binding Order}" />
            </TabItem>
        </TabControl>

    </Grid>
</Window>
